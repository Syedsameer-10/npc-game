NPC MasterBot {
    WHEN HEALTH_LOW:
        STOP

    WHEN PIT_AHEAD:
        JUMP

    WHEN WALL_AHEAD:
        TURN_LEFT | TURN_RIGHT

    WHEN ENEMY_NEAR:
        ATTACK

    WHEN TREASURE_NEAR:
        COLLECT

    WHEN PLAYER_SEEN:
        CHASE

    WHEN PLAYER_NEAR:
        RUN_AWAY

    WHEN DOOR_AHEAD:
        STOP

    WHEN PATH_CLEAR:
        MOVE_FORWARD
}
